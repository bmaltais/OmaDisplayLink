#!/usr/bin/env bash
# omadisplaylink: the command behind the OmaDisplayLink bar icon, and a friendly front door to the scripts.
#
#   omadisplaylink status [--json|--write]   what state the dock is in (--write feeds the bar icon)
#   omadisplaylink setup                     guided install + configure, in this terminal
#   omadisplaylink repair                    fix what status says is wrong (asks before it does anything)
#   omadisplaylink report                    copy a sanitized report to the clipboard
#   omadisplaylink doctor                    print that report here
#   omadisplaylink launch setup|repair       setup or repair, in a floating terminal
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
SCRIPTS="$HERE/../scripts"
STATUS_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/OmaDisplayLink/status"
# Demo mode (the plugin test session): a file naming the state to report, and nothing real is touched.
DEMO_FILE="$HOME/.config/OmaDisplayLink/demo"   # $HOME only: a session sets HOME, not always XDG_CONFIG_HOME
demo() { [[ -r $DEMO_FILE ]]; }

usage() { sed -n '2,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }
fail() { echo "omadisplaylink: $*" >&2; exit 1; }

# "connected enabled" counts for the dock's screens: connectors on cards that evdi drives.
evdi_outputs() {
  local connected=0 enabled=0 dir card driver
  for dir in /sys/class/drm/card*-*; do
    [[ -r $dir/status ]] || continue
    card="${dir##*/}"
    card="${card%%-*}"
    driver="$(basename "$(readlink -f "/sys/class/drm/$card/device/driver" 2>/dev/null)")"
    [[ $driver == evdi ]] || continue
    if [[ $(<"$dir/status") == connected ]]; then
      connected=$((connected + 1))
      [[ $(<"$dir/enabled") == enabled ]] && enabled=$((enabled + 1))
    fi
  done
  echo "$connected $enabled"
}

dock_attached() {
  local dev
  for dev in /sys/bus/usb/devices/*; do
    [[ $(cat "$dev/idVendor" 2>/dev/null) == 17e9 ]] && return 0
  done
  return 1
}

# Prints "<kind> <message>". Kinds: unconfigured (driver not installed), idle (no dock plugged in),
# ok (dock screens active), attention (something is wrong and the message says what).
compute_status() {
  if demo; then
    # Line 1 of the demo file is the state; line 2, if any, the action the card should offer.
    local demo_action
    demo_action="$(sed -n 2p "$DEMO_FILE")"
    case "$(head -n1 "$DEMO_FILE")" in
      unconfigured) echo "unconfigured|setup|DisplayLink is not installed on this machine." ;;
      ok) echo "ok||2 dock screens active." ;;
      attention) echo "attention|$demo_action|1 of 2 dock screens have no picture. Check the monitor's input source and cable." ;;
      *) echo "idle||No DisplayLink dock is plugged in." ;;
    esac
    return
  fi
  if ! pacman -Q evdi-dkms displaylink >/dev/null 2>&1; then
    echo "unconfigured|setup|DisplayLink is not installed on this machine."
    return
  fi
  if ! dock_attached; then
    echo "idle||No DisplayLink dock is plugged in."
    return
  fi
  # The service is started by udev when a dock appears and stops when it goes, so check it only now.
  if [[ $(systemctl is-active displaylink.service 2>/dev/null || true) != active ]]; then
    echo "attention|service|The DisplayLink service is not running, so the dock shows nothing."
    return
  fi
  if "$SCRIPTS/displaylink-aquamarine-patch.sh" --needed >/dev/null 2>&1 &&
    ! "$SCRIPTS/displaylink-aquamarine-patch.sh" --status >/dev/null 2>&1; then
    echo "attention|patch|An update replaced the NVIDIA fix in Aquamarine, so the dock screens have no picture."
    return
  fi
  local connected enabled
  read -r connected enabled < <(evdi_outputs)
  if ((connected > 0 && enabled < connected)); then
    echo "attention||$((connected - enabled)) of $connected dock screens have no picture. Check the monitor's input source and cable."
  else
    echo "ok||$enabled dock screen(s) active."
  fi
}

cmd_status() {
  local mode="${1:-}" line kind action message
  line="$(compute_status)"
  IFS='|' read -r kind action message <<<"$line"
  case "$mode" in
    --json) jq -nc --arg kind "$kind" --arg action "$action" --arg message "$message" '{kind: $kind, action: $action, message: $message}' ;;
    --write)
      mkdir -p "$(dirname "$STATUS_FILE")"
      # Line 1 is the state, line 2 the sentence the bar shows, line 3 the action the card offers. Only
      # rewrite when it changed, so the bar is not told to redraw for nothing. The JSON on stdout is for the service.
      [[ $(cat "$STATUS_FILE" 2>/dev/null || true) == "$kind"$'\n'"$message"$'\n'"$action" ]] || printf '%s\n%s\n%s' "$kind" "$message" "$action" >"$STATUS_FILE"
      jq -nc --arg kind "$kind" --arg action "$action" --arg message "$message" '{kind: $kind, action: $action, message: $message}'
      ;;
    "") echo "$kind: $message" ;;
    *) fail "status: unknown option $mode" ;;
  esac
}

cmd_doctor() {
  if demo; then
    echo "Demo: this would print the sanitized DisplayLink report."
    read -r -p "Press Enter to close. " _
    return
  fi
  exec "$SCRIPTS/displaylink-detect.sh" --sanitize
}

cmd_setup() {
  if demo; then
    echo "Demo: this would install and configure DisplayLink. Nothing is changed."
    read -r -p "Press Enter to close. " _
    return
  fi
  command -v gum >/dev/null 2>&1 || fail "gum is required (it ships with Omarchy)"
  echo "OmaDisplayLink setup"
  echo
  "$SCRIPTS/displaylink-detect.sh" || true
  echo
  gum confirm "Install and configure DisplayLink on this machine?" || exit 130
  if gum confirm "Take a system snapshot first? (recommended)"; then
    omarchy snapshot create || echo "Snapshot failed; continuing."
  fi
  "$SCRIPTS/displaylink-install.sh"
  "$SCRIPTS/displaylink-configure.sh" --apply-monitors
  if "$SCRIPTS/displaylink-aquamarine-patch.sh" --needed >/dev/null 2>&1; then
    echo
    echo "Hyprland renders on NVIDIA: building the patched Aquamarine..."
    "$SCRIPTS/displaylink-aquamarine-patch.sh"
    "$SCRIPTS/displaylink-aquamarine-patch.sh" --install-hook
  fi
  cmd_status --write || true
  echo
  echo "Done. Log out and back in with the dock attached."
  read -r -p "Press Enter to close. " _
}

cmd_report() {
  if demo; then
    echo "Demo: this would copy the sanitized report to the clipboard."
    return
  fi
  command -v wl-copy >/dev/null 2>&1 || fail "wl-copy is required (pacman -S wl-clipboard)"
  "$SCRIPTS/displaylink-detect.sh" --sanitize | wl-copy
  omarchy-notification-send "DisplayLink report copied" "Paste it into a GitHub issue." 2>/dev/null || true
  echo "Report copied to the clipboard."
}

# Fixes the one thing status says is wrong. Each branch says what it will do and asks first.
cmd_repair() {
  local line kind action message
  line="$(compute_status)"
  IFS='|' read -r kind action message <<<"$line"
  if demo; then
    echo "Demo: this would repair: ${action:-nothing to repair}. Nothing is changed."
    read -r -p "Press Enter to close. " _
    return
  fi
  command -v gum >/dev/null 2>&1 || fail "gum is required (it ships with Omarchy)"
  echo "$message"
  echo
  case "$action" in
    patch)
      echo "This rebuilds Arch's Aquamarine with the DisplayLink fix and installs it. It takes a few minutes"
      echo "and asks for your password. Log out and back in afterwards."
      echo
      gum confirm "Rebuild and install the patched Aquamarine?" || exit 130
      "$SCRIPTS/displaylink-aquamarine-patch.sh"
      ;;
    service)
      echo "This restarts displaylink.service (the DisplayLink driver process). It asks for your password."
      echo
      gum confirm "Restart the DisplayLink service?" || exit 130
      sudo systemctl restart displaylink.service
      ;;
    *) echo "Nothing the plugin can repair. If a screen shows no signal, check the monitor's input source and cable." ;;
  esac
  cmd_status --write >/dev/null || true
  read -r -p "Press Enter to close. " _
}

cmd_launch() {
  case "${1:-}" in
    setup | repair) ;;
    *) fail "launch: expected setup or repair" ;;
  esac
  exec omarchy-launch-floating-terminal-with-presentation "$(printf '%q ' "$HERE/omadisplaylink" "$1")"
}

case "${1:-}" in
  status) cmd_status "${2:-}" ;;
  setup) cmd_setup ;;
  doctor) cmd_doctor ;;
  report) cmd_report ;;
  repair) cmd_repair ;;
  launch) cmd_launch "${2:-}" ;;
  -h | --help | help | "") usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
