# Body of the marked block that displaylink-configure.sh puts in ~/.config/uwsm/env-hyprland.
# It runs in sh at session start, before Hyprland. The GPU is resolved at login instead of
# hardcoded, so a missing udev symlink can never leave AQ_DRM_DEVICES pointing at nothing,
# and an evdi card can never end up as the primary device.
gpu=
for cand in /dev/dri/nvidia-gpu /dev/dri/amd-gpu /dev/dri/intel-gpu /dev/dri/gpu; do
  if [ -e "$cand" ]; then
    gpu=$cand
    break
  fi
done

# Fallback: first non-evdi DRM card that drives a display. On Apple Silicon (Asahi) the GPU is
# its own render-only card with no connectors and the display controller is a separate card; picking
# the first card would leave the built-in panel with no device to scan out on. If no card has a
# connector yet (nothing probed at login), take the first non-evdi card. A card whose only
# connectors are DSI does not count first: on a MacBook the Touch Bar is its own card (DSI-1)
# and the built-in panel (eDP-1) sits on the display subsystem card.
if [ -z "$gpu" ]; then
  for need_connector in 2 1 0; do
    for card in /dev/dri/card[0-9]*; do
      [ -e "$card" ] || continue
      name=$(basename "$card")
      driver_link="/sys/class/drm/${name}/device/driver"
      [ -e "$driver_link" ] || continue
      driver=$(basename "$(readlink -f "$driver_link")")
      [ "$driver" = evdi ] && continue
      if [ "$need_connector" != 0 ]; then
        found=0
        for conn in "/sys/class/drm/${name}-"*; do
          [ -e "$conn" ] || continue
          case "${conn##*/${name}-}" in DSI-*) [ "$need_connector" = 2 ] && continue ;; esac
          found=1
          break
        done
        [ "$found" = 1 ] || continue
      fi
      gpu=$card
      break
    done
    [ -n "$gpu" ] && break
  done
fi

# With no usable GPU, leave AQ_DRM_DEVICES unset so Aquamarine uses its defaults.
if [ -n "$gpu" ]; then
  aq=$gpu
  [ -e /dev/dri/evdi0 ] && aq="${aq}:/dev/dri/evdi0"
  [ -e /dev/dri/evdi1 ] && aq="${aq}:/dev/dri/evdi1"
  export AQ_DRM_DEVICES="$aq"
  # NVIDIA workarounds only when NVIDIA is the GPU we render on, not merely loaded (hybrid laptops).
  gpu_driver=$(basename "$(readlink -f "/sys/class/drm/$(basename "$(readlink -f "$gpu")")/device/driver")" 2>/dev/null)
  if [ "$gpu_driver" = nvidia ]; then
    export AQ_FORCE_LINEAR_BLIT=0
    export AQ_MGPU_NO_EXPLICIT=1
    # AQ_NO_MODIFIERS=1 is NOT set by default: on some NVIDIA setups it greys out the native
    # outputs too. Without it, evdi may fail to import buffers (outputs stay 0x0).
    # displaylink-configure.sh --no-modifiers appends it at the end of this block.
  fi
fi
